# Public, pinned base. The build context contains no project data or weights.
FROM pytorch/pytorch:2.1.2-cuda12.1-cudnn8-devel@sha256:a5de097b482f5927baf2322f4419f11044bfe4f08c7b7593dbaff8e41d03a204

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    git libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

# Keep NumPy below 2 for the PyTorch 2.1 / MMCV 1.x binary interfaces.
RUN python -m pip install \
    "numpy==1.26.4" "pandas==2.3.3" "opencv-python==4.9.0.80" \
    "Pillow==12.1.1" "scipy==1.15.3" "scikit-image==0.25.2" \
    "matplotlib==3.10.8" "seaborn==0.13.2" \
    "ultralytics==8.4.14" "yacs==0.1.8" "natsort==8.4.0" \
    "pycocotools==2.0.11" "terminaltables==3.1.10" \
    "addict==2.4.0" "yapf==0.43.0" \
    "hydra-core==1.3.2" "wandb==0.19.11" "ninja==1.11.1.4"

# Build MMCV's CUDA operators for the target GPU, not for a different host.
ARG CUDA_ARCH_LIST=8.6
ENV MMCV_WITH_OPS=1 \
    FORCE_CUDA=1 \
    TORCH_CUDA_ARCH_LIST=${CUDA_ARCH_LIST} \
    MAX_JOBS=4
RUN python -m pip install --no-build-isolation --no-deps --no-binary mmcv-full \
    "mmcv-full==1.7.2"
RUN python -m pip install --no-deps "mmdet==2.28.2"

RUN python -c "import torch, cv2, mmcv, mmdet, ultralytics; from mmcv.ops import nms; print('release imports OK')"
WORKDIR /workspace
